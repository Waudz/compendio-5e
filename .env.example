# Copie para .env.local (não versionado) e preencha com os valores do SEU projeto Supabase.
# Painel do Supabase > Project Settings > API.
# Use APENAS a URL e a chave pública (anon / publishable). NUNCA coloque a service_role key aqui:
# variáveis VITE_* vão para o navegador e ficam visíveis a qualquer visitante.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-publica-anon
